# Copy this file to .env and fill it in.

# Required — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — your GitHub username, so "pull my SEUNAS repo" knows the owner
GITHUB_USERNAME=

# Optional — needed for private repos (github.com/settings/tokens, "repo" scope)
GITHUB_TOKEN=

# Optional — where repos are downloaded (default ~/JarvisRepos)
# JARVIS_REPOS_DIR=~/JarvisRepos

# Optional — Gemini model (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
